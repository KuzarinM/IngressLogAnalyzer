{
    "name": "log-geo-analyzer-pro",
    "version": "1.0.0",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
        "electron:build": "vite build && electron-builder"
    },
    "build": {
        "appId": "com.geoanalyzer.app",
        "productName": "Log Geo Analyzer",
        "directories": {
            "output": "dist_electron"
        },
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "win": {
            "target": "nsis",
            "icon": "public/favicon.ico"
        },
        "mac": {
            "target": "dmg"
        },
        "linux": {
            "target": "AppImage"
        }
    },
    "dependencies": {
        "gitignore": "^0.7.0",
        "leaflet": "^1.9.4",
        "vue": "^3.4.15"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.0.3",
        "autoprefixer": "^10.4.17",
        "concurrently": "^9.2.1",
        "electron": "^39.2.7",
        "electron-builder": "^26.0.12",
        "electron-squirrel-startup": "^1.0.1",
        "postcss": "^8.4.33",
        "tailwindcss": "^3.4.1",
        "vite": "^5.0.12",
        "wait-on": "^9.0.3"
    }
}
